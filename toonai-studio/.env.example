DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toonai
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
FRONTEND_URL=http://localhost:5173

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=toonai
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# AI providers - leave blank until configured
VIDEO_PROVIDER=
VIDEO_API_KEY=
IMAGE_VIDEO_PROVIDER=
IMAGE_VIDEO_API_KEY=
TEXT_PROVIDER=
TEXT_API_KEY=
VOICE_PROVIDER=
VOICE_API_KEY=

# OAuth / OTP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER=
OTP_API_KEY=

# Google Play Billing verification
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional rewarded ads verification
REWARDED_ADS_PROVIDER=
REWARDED_ADS_SECRET=
